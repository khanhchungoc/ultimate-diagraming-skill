{
  "_readme": "How to read this model: \"entities\" are tables, each with \"columns\" in order (\"pk\", \"fk\", \"unique\", \"nullable\"); each relationship goes \"from\" the child table that holds the foreign key \"columns\" \"to\" the parent; \"fromEnd\"/\"toEnd\" are crow's-foot ends (one, zeroOrOne, oneOrMany, zeroOrMany); \"identifying\": true means the key is part of the child's primary key; \"groups\" are subject areas; \"layout\" is display-only and can be skipped.",
  "diagramType": "erd",
  "schemaVersion": 3,
  "title": "ER diagram",
  "colorKey": { "1": "Accounts & Orders", "3": "Catalog" },
  "entities": [
    {
      "id": "user",
      "name": "user",
      "color": "1",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "email", "type": "text", "unique": true },
        { "name": "name", "type": "text" },
        { "name": "created_at", "type": "timestamptz" }
      ]
    },
    {
      "id": "order",
      "name": "order",
      "color": "1",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "user_id", "type": "uuid", "fk": true },
        { "name": "status", "type": "text", "note": "new, paid, shipped" },
        { "name": "placed_at", "type": "timestamptz" }
      ]
    },
    {
      "id": "order_item",
      "name": "order_item",
      "color": "1",
      "columns": [
        { "name": "order_id", "type": "uuid", "pk": true, "fk": true },
        { "name": "product_id", "type": "uuid", "pk": true, "fk": true },
        { "name": "qty", "type": "int" },
        { "name": "unit_price", "type": "numeric" }
      ]
    },
    {
      "id": "payment",
      "name": "payment",
      "color": "1",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "order_id", "type": "uuid", "fk": true, "unique": true },
        { "name": "amount", "type": "numeric" },
        { "name": "paid_at", "type": "timestamptz", "nullable": true }
      ]
    },
    {
      "id": "product",
      "name": "product",
      "color": "3",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "category_id", "type": "uuid", "fk": true },
        { "name": "sku", "type": "text", "unique": true },
        { "name": "name", "type": "text" },
        { "name": "price", "type": "numeric" }
      ]
    },
    {
      "id": "category",
      "name": "category",
      "color": "3",
      "columns": [
        { "name": "id", "type": "uuid", "pk": true },
        { "name": "name", "type": "text", "unique": true }
      ]
    }
  ],
  "relationships": [
    { "id": "r1", "from": "order", "to": "user", "columns": ["user_id"], "fromEnd": "zeroOrMany", "toEnd": "one", "label": "places" },
    { "id": "r2", "from": "order_item", "to": "order", "columns": ["order_id"], "fromEnd": "oneOrMany", "toEnd": "one", "identifying": true },
    { "id": "r3", "from": "order_item", "to": "product", "columns": ["product_id"], "fromEnd": "zeroOrMany", "toEnd": "one", "identifying": true },
    { "id": "r4", "from": "payment", "to": "order", "columns": ["order_id"], "fromEnd": "zeroOrOne", "toEnd": "one", "label": "settles" },
    { "id": "r5", "from": "product", "to": "category", "columns": ["category_id"], "fromEnd": "zeroOrMany", "toEnd": "one", "label": "in" }
  ],
  "notes": [
    { "id": "n1", "text": "Orders keep their items even when cancelled", "entities": ["order"] }
  ]
