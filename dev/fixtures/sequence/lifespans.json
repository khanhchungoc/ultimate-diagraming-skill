{
  "diagramType": "sequence",
  "title": "Payment phases, trimmed lifelines",
  "numbered": true,
  "lifespans": true,
  "participants": [
    { "id": "cust", "name": "Customer", "kind": "actor" },
    { "id": "fe", "name": "Q&B UI", "kind": "ui" },
    { "id": "pol", "name": "Policy Svc", "kind": "system" },
    { "id": "pay", "name": "Payment Svc", "kind": "system" },
    { "id": "spm", "name": "SPM", "kind": "external" },
    { "id": "bus", "name": "Service Bus", "kind": "queue", "start": "m15" },
    { "id": "job", "name": "Background Job", "kind": "system" },
    { "id": "db", "name": "Policy DB", "kind": "database" }
  ],
  "messages": [
    { "id": "m1", "from": "cust", "to": "fe", "label": "Confirm quote and pay", "kind": "sync" },
    { "id": "m2", "from": "fe", "to": "pol", "label": "Pre-purchase validation", "detail": "quote id, CPA answers", "kind": "sync" },
    { "id": "m3", "from": "pol", "to": "db", "label": "Save CPA answers", "detail": "quote id, answers, timestamp", "kind": "sync" },
    { "id": "m4", "from": "db", "to": "pol", "label": "Saved", "kind": "reply" },
    { "id": "m5", "from": "pol", "to": "fe", "label": "Validation passed", "kind": "reply" },
    { "id": "m6", "from": "fe", "to": "pay", "label": "Register payment", "detail": "CPA answers, amount, payment method, holding page URL", "kind": "sync" },
    { "id": "m7", "from": "pay", "to": "spm", "label": "Create payment session", "detail": "amount, currency, return URL", "kind": "sync" },
    { "id": "m8", "from": "spm", "to": "pay", "label": "Session", "detail": "session id, redirect URL", "kind": "reply" },
    { "id": "m9", "from": "pay", "to": "db", "label": "Store payment", "detail": "payment-status = Registered", "kind": "async" },
    { "id": "m10", "from": "pay", "to": "fe", "label": "Payment registered", "detail": "payment id, redirect URL", "kind": "reply" },
    { "id": "m11", "from": "fe", "to": "cust", "label": "Redirect to payment page", "kind": "async" },
    { "id": "m12", "from": "cust", "to": "spm", "label": "Enter card details", "kind": "sync" },
    { "id": "m13", "from": "spm", "to": "spm", "label": "3-D Secure check", "kind": "sync" },
    { "id": "m14", "from": "spm", "to": "cust", "label": "Outcome page", "kind": "reply" },
    { "id": "m15", "from": "spm", "to": "pay", "label": "Payment notification", "detail": "payment id, payment-status", "kind": "async" },
    { "id": "m16", "from": "spm", "to": "fe", "label": "Return to holding page", "detail": "payment id", "kind": "async" },
    { "id": "m17", "from": "pay", "to": "db", "label": "Update payment status", "detail": "payment-status", "kind": "sync" },
    { "id": "m18", "from": "db", "to": "pay", "label": "Updated", "kind": "reply" },
    { "id": "m19", "from": "pay", "to": "bus", "label": "PaymentStatusChanged", "detail": "payment id, payment-status", "kind": "async" },
    { "id": "m20", "from": "fe", "to": "pol", "label": "Get payment status", "detail": "payment id", "kind": "sync" },
    { "id": "m21", "from": "pol", "to": "pay", "label": "Fetch payment status", "kind": "sync" },
    { "id": "m22", "from": "pay", "to": "pol", "label": "payment-status", "kind": "reply" },
    { "id": "m23", "from": "pol", "to": "fe", "label": "payment-status", "kind": "reply" },
    { "id": "m24", "from": "fe", "to": "cust", "label": "Payment cancelled, try again", "kind": "async" },
    { "id": "m25", "from": "fe", "to": "pol", "label": "Release quote lock", "detail": "quote id", "kind": "async" },
    { "id": "m26", "from": "fe", "to": "cust", "label": "Show error and support number", "kind": "async" },
    { "id": "m27", "from": "pol", "to": "job", "label": "Raise payment incident", "detail": "payment id, error code", "kind": "async" },
    { "id": "m28", "from": "bus", "to": "pol", "label": "PaymentStatusChanged", "detail": "payment-status = Success", "kind": "async" },
    { "id": "m29", "from": "fe", "to": "pol", "label": "Complete purchase", "detail": "quote id, payment id", "kind": "sync" },
    { "id": "m30", "from": "pol", "to": "db", "label": "Load quote", "detail": "quote id", "kind": "sync" },
    { "id": "m31", "from": "db", "to": "pol", "label": "Quote and CPA answers", "kind": "reply" },
    { "id": "m32", "from": "pol", "to": "job", "label": "Issue policy", "detail": "quote id, payment id", "kind": "sync" },
    { "id": "m33", "from": "job", "to": "db", "label": "Create policy", "detail": "policy number, start date, premium", "kind": "sync" },
    { "id": "m34", "from": "db", "to": "job", "label": "Policy number", "kind": "reply" },
    { "id": "m35", "from": "job", "to": "job", "label": "Generate documents", "detail": "schedule, certificate, IPID", "kind": "sync" },
    { "id": "m36", "from": "job", "to": "pol", "label": "Policy issued", "detail": "policy number, document links", "kind": "reply" },
    { "id": "m37", "from": "pol", "to": "bus", "label": "CreateSystemTask", "detail": "policy number, reason", "kind": "async" },
    { "id": "m38", "from": "pol", "to": "fe", "label": "Processing result (failed)", "detail": "error code", "kind": "reply" },
    { "id": "m39", "from": "pol", "to": "bus", "label": "PolicyIssued", "detail": "policy number", "kind": "async" },
    { "id": "m40", "from": "pol", "to": "fe", "label": "Processing result (success)", "detail": "policy number", "kind": "reply" },
    { "id": "m41", "from": "fe", "to": "cust", "label": "Show confirmation", "detail": "policy number, documents link", "kind": "async" },
    { "id": "m42", "from": "bus", "to": "pay", "label": "PolicyIssued", "detail": "policy number", "kind": "async" }
  ],
  "fragments": [
    { "id": "f1", "kind": "group", "label": "Register Payment", "color": "yellow", "from": "m2", "to": "m10" },
    { "id": "f2", "kind": "group", "label": "pre-purchase processing", "from": "m2", "to": "m5" },
    { "id": "f3", "kind": "group", "label": "SPM", "color": "blue", "from": "m12", "to": "m16" },
    { "id": "f4", "kind": "loop", "label": "push data every second", "from": "m20", "to": "m23" },
    {
      "id": "f5",
      "kind": "alt",
      "label": "payment-status = Cancelled",
      "from": "m24",
      "to": "m42",
      "branches": [
        { "at": "m26", "label": "payment-status = any error" },
        { "at": "m28", "label": "payment-status = Success" }
      ]
    },
    { "id": "f6", "kind": "group", "label": "Post-payment processing", "color": "green", "from": "m29", "to": "m41" },
    { "id": "f7", "kind": "opt", "label": "CreateSystemTask failed", "from": "m37", "to": "m38" }
  ],
  "notes": [
    { "id": "n1", "text": "On Q&B Holding page", "over": "fe", "before": "m20" },
    { "id": "n2", "text": "Payment session expires after 15 minutes", "over": ["pay", "spm"], "after": "m8" },
    { "id": "n3", "text": "Card data never reaches Q&B: SPM hosts the payment page", "over": "spm", "after": "m13" },
    { "id": "n4", "text": "Policy documents are kept for 7 years", "over": "job", "after": "m35" }
  ]
}
