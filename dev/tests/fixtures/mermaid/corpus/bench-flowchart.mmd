flowchart TB
  subgraph HM["Hiring Manager"]
    A1["1. Raise hiring request<br/>(role, grade, budget code)"]
    HM1{"Approve job ad?"}
    HM2["Interview round 1"]
    HM3{"Advance?"}
    HM4["Interview round 2"]
    HM5{"Advance?"}
    HM6["Day 45: notified of overdue training"]
    HM7["Day 90: probation review"]
    HM8{"Outcome?"}
  end
  subgraph HR["HR Operations"]
    B1{"Approved headcount?"}
    B2["Finance approval<br/>(budget holder sign-off if grade above 7)"]
    B3{"Finance approves?"}
    B4["HR Director approval"]
    B5{"Approved?"}
    B6["Order background check"]
    B7{"Adverse finding?"}
    B8["Review with Legal guidance"]
    B9{"Disqualifying?"}
    B10["Record exception"]
    B11["Send welcome email + Day 1 agenda"]
    B12["Termination processing"]
  end
  subgraph RC["Recruiter"]
    C1["Draft job ad"]
    C2["Publish: careers site + 2 job boards"]
    C3["Screen applications (within 5 working days),<br/>shortlist, schedule interviews"]
    C4["Send rejection email"]
    C5{"Salary within band?"}
    C6["Renegotiate with Candidate"]
    C7["Issue offer letter"]
  end
  subgraph CA["Candidate / Employee"]
    D1{"Response?"}
    D2["Sign contract electronically"]
    D3["Day 1: collect access card,<br/>receive laptop, sign IT AUP"]
  end
  subgraph BV["Background Check Vendor"]
    E1["Verify identity, right to work,<br/>employment history (5 yrs), criminal record<br/>Report within 10 working days"]
  end
  subgraph PAR["Pre-Day-1 setup (parallel, all 4 must finish before Day 1)"]
    subgraph IT["IT Service Desk"]
      F1["Create user account"]
      F2{"Laptop in stock?"}
      F3["Order laptop (3-day SLA)"]
      F4["Assign laptop"]
      F5["Enrol device in MDM"]
    end
    subgraph FA["Facilities"]
      G1["Assign desk"]
      G2["Order building access card"]
    end
    subgraph PY["Payroll"]
      H1["Set up employee record,<br/>bank details, tax code"]
    end
    subgraph SO["Security Office"]
      I1["Issue security briefing pack"]
    end
  end
  subgraph TR["Training Team"]
    J1["Enrol in mandatory training<br/>(conduct, data protection, security) due in 30 days"]
    J2{"Overdue at day 30?"}
    J3["Send reminder"]
    J4{"Overdue at day 45?"}
    J5["Suspend access until completion"]
  end

  X1(["Hiring Request Rejected"])
  X2(["Candidate Rejected"])
  X3(["Offer Declined"])
  X4(["Offer Withdrawn"])
  X5(["Probation Passed"])
  X6(["Employment Terminated"])
  JOIN(("All 4 done"))

  A1 --> B1
  B1 -- yes --> C1
  B1 -- no --> B2 --> B3
  B3 -- yes --> C1
  B3 -- no --> X1
  C1 --> HM1
  HM1 -- no: revise, resubmit --> C1
  HM1 -- yes --> C2 --> C3 --> HM2 --> HM3
  HM3 -- yes --> HM4 --> HM5
  HM3 -- no --> C4
  HM5 -- no --> C4
  C4 --> X2
  HM5 -- yes, selected --> C5
  C5 -- above band --> B4 --> B5
  B5 -- declined --> C6 --> C5
  B5 -- approved --> C7
  C5 -- within band --> C7
  C7 --> D1
  D1 -- decline --> X3
  D1 -- counter --> C5
  D1 -- accept --> D2 --> B6 --> E1 --> B7
  B7 -- no --> JOIN0[" "]
  B7 -- yes --> B8 --> B9
  B9 -- yes --> X4
  B9 -- no --> B10 --> JOIN0
  JOIN0 -- cleared --> F1 & G1 & H1 & I1
  F1 --> F2
  F2 -- no --> F3 --> F4
  F2 -- yes --> F4
  F4 --> F5 --> JOIN
  G1 --> G2 --> JOIN
  H1 --> JOIN
  I1 --> JOIN
  JOIN --> B11 --> D3 --> J1 --> J2
  J2 -- no: completed --> HM7
  J2 -- yes --> J3 --> J4
  J4 -- no --> HM7
  J4 -- yes --> HM6 --> J5 --> HM7
  HM7 --> HM8
  HM8 -- pass --> X5
  HM8 -- "extend +30 days (once)" --> HM7
  HM8 -- fail --> B12 --> X6

  classDef term fill:#fde,stroke:#a36,color:#000
  class X1,X2,X3,X4,X6 term
  classDef ok fill:#dfd,stroke:#383,color:#000
  class X5 ok
  style JOIN0 width:6px,height:6px
