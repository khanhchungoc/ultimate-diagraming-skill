      "text": "Screened within 5 working days",
      "nodes": [
        "screen_apps"
      ]
    },
    {
      "id": "n5",
      "text": "Recruiter renegotiates salary with candidate",
      "nodes": [
        "renegotiate_salary"
      ]
    },
    {
      "id": "n6",
      "text": "Verifies ID, right to work, 5-year employment history and criminal record\nReport returned within 10 working days",
      "nodes": [
        "verify_bg"
      ]
    },
    {
      "id": "n7",
      "text": "3-day SLA for out-of-stock laptop order",
      "nodes": [
        "order_laptop"
      ]
    },
    {
      "id": "n8",
      "text": "Includes employee record, bank details and tax code",
      "nodes": [
        "setup_payroll"
      ]
    },
    {
      "id": "n9",
      "text": "All four parallel tracks must complete before Day 1\nIncludes Day 1 agenda",
      "nodes": [
        "send_welcome"
      ]
    },
    {
      "id": "n10",
      "text": "Day 1: card collected from Facilities, laptop received from IT",
      "nodes": [
        "collect_card",
        "receive_laptop"
      ]
    },
    {
      "id": "n11",
      "text": "Code of conduct, data protection and security awareness\nDue within 30 days",
      "nodes": [
        "enrol_training"
      ]
    },
    {
      "id": "n12",
      "text": "Access suspended at day 45 until mandatory training is completed",
      "nodes": [
        "suspend_access"
      ]
    },
    {
      "id": "n13",
      "text": "Adds 30 days and repeats probation review once",
