    { "id": "r10", "from": "order", "to": "address", "columns": ["ship_address_id"], "fromEnd": "zeroOrMany", "toEnd": "one", "label": "ships to" },
    { "id": "r11", "from": "order_item", "to": "order", "columns": ["order_id"], "fromEnd": "oneOrMany", "toEnd": "one", "identifying": true },
    { "id": "r12", "from": "order_item", "to": "product", "columns": ["product_id"], "fromEnd": "zeroOrMany", "toEnd": "one", "identifying": true },
    { "id": "r13", "from": "shipment", "to": "order", "columns": ["order_id"], "fromEnd": "zeroOrMany", "toEnd": "one", "label": "fulfills" },
