    { "id": "r3", "from": "subscription", "to": "organization", "columns": ["org_id"], "fromEnd": "zeroOrMany", "toEnd": "one", "label": "subscribes" },
    { "id": "r4", "from": "subscription", "to": "plan", "columns": ["plan_id"], "fromEnd": "zeroOrMany", "toEnd": "one", "label": "uses" },
